{
  "openapi": "3.0.1",
  "info": {
    "title": "用户管理 API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "tags": ["用户"],
        "summary": "查询用户列表",
        "description": "分页返回全部用户",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码（从 1 起）",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "description": "每页条数",
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "用户分页列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["用户"],
        "summary": "创建用户",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "请求追踪头",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["用户"],
        "summary": "查询单个用户",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "用户不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["管理"],
        "summary": "删除用户",
        "responses": {
          "204": { "description": "已删除，无返回体" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "username"],
        "description": "用户实体",
        "example": { "id": 1001, "username": "alice", "role": "admin" },
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "用户 ID",
            "example": 1001
          },
          "username": {
            "type": "string",
            "description": "用户名（登录凭证，全局唯一）",
            "example": "alice"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "user"],
            "description": "角色"
          },
          "profile": { "$ref": "#/components/schemas/Profile" },
          "friends": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/User" }
          }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["username", "email"],
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名（登录凭证，全局唯一）",
            "example": "alice"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "tagList": {
            "type": "array",
            "description": "标签 ID 列表",
            "items": { "type": "integer" }
          },
          "profile": { "$ref": "#/components/schemas/Profile" }
        }
      },
      "Profile": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string",
            "description": "显示名称",
            "example": "Alice"
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "example": 28
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "description": "错误信息"
          }
        }
      }
    }
  }
}
